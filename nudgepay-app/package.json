{
  "name": "nudgepay-app",
  "private": true,
  "description": "NudgePay — collections workspace for QuickBooks (React Router 7 on Cloudflare Workers).",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types && react-router typegen",
    "typegen": "wrangler types && react-router typegen",
    "check": "tsc && react-router build && node scripts/strip-build-dev-vars.mjs && node scripts/deploy-preflight.mjs --built-config build/server/wrangler.json --environment production && wrangler deploy --dry-run",
    "deploy": "node scripts/deploy-worker.mjs",
    "deploy:staging": "node scripts/deploy-worker.mjs --staging",
    "dev": "react-router dev",
    "preview": "npm run build && vite preview",
    "typecheck": "npm run typegen && tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:authenticated": "node e2e/authenticated/run.mjs",
    "qualify:load": "node scripts/pilot-load.mjs",
    "qualify:fixtures": "node scripts/seed-pilot-load.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "verify:required-checks": "node scripts/verify-required-checks.mjs",
    "start": "node server.js",
    "build:cron": "node scripts/build-cron.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-router/express": "7.18.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "express": "^5.2.1",
    "isbot": "5.1.32",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.35.0",
    "@cloudflare/workers-types": "^4.20260621.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "7.18.2",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.27.7",
    "supabase": "^2.107.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^4.1.9",
    "wrangler": "^4.88.0"
  },
  "cloudflare": {
    "label": "NudgePay",
    "products": [
      "Workers"
    ],
    "categories": [
      "storage"
    ],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/36a99c4a-8919-4e6e-ac9e-e55974407200/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/65455e96-7992-425f-44e4-30f3e7d7f900/preview",
    "publish": false
  }
}
